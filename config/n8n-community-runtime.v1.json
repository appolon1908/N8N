{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "schema_version": "1.0",
  "contract_id": "codestra.n8n-community-runtime",
  "status": "PREPARED_NOT_APPLIED",
  "edition": "community",
  "repositories": {
    "runtime": "appolon1908-hue/N8N",
    "edge": "appolon1908-hue/Caddy",
    "gateway": "appolon1908-hue/Kong",
    "identity": "appolon1908-hue/Keycloak",
    "write_boundary": "appolon1908-hue/Middleware-"
  },
  "activation_authorized": false,
  "minimum_runtime_version": "2.32.1",
  "runtime_image": {
    "status": "UNVERIFIED",
    "minimum_runtime_version": "2.32.1",
    "approved_image": null,
    "approved_image_version": null,
    "image_digest_evidence_sha256": null,
    "version_evidence_sha256": null
  },
  "endpoint": {
    "base_url": "https://api.codestra.co",
    "fixed_https_gateway": true,
    "direct_private_middleware_listener_allowed": false,
    "direct_provider_endpoints_allowed": false,
    "routes": [
      {
        "method": "POST",
        "path": "/v2/automation/jobs/claim",
        "scope": "automation.job.claim",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "GET",
        "path": "/v2/automation/jobs/{job_id}",
        "scope": "automation.job.read",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/jobs/{job_id}/heartbeat",
        "scope": "automation.job.heartbeat",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/jobs/{job_id}/steps",
        "scope": "automation.job.step.write",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/jobs/{job_id}/complete",
        "scope": "automation.job.complete",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/jobs/{job_id}/fail",
        "scope": "automation.job.fail",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/commands",
        "scope": "automation.command.crm",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "GET",
        "path": "/v2/automation/commands/{command_id}",
        "scope": "automation.command.read",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/approvals",
        "scope": "automation.approval.request",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "GET",
        "path": "/v2/automation/approvals/{approval_id}",
        "scope": "automation.approval.read",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/dead-letters/{dead_letter_id}/replay",
        "scope": "automation.operations.replay.request",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "POST",
        "path": "/v2/automation/jobs/reconcile",
        "scope": "automation.operations.reconcile",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "GET",
        "path": "/v2/automation/capabilities/{capability}",
        "scope": "automation.capability.read",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID"
        ]
      },
      {
        "method": "POST",
        "path": "/api/v1/integrations/n8n/results",
        "scope": "n8n.results.submit",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID",
          "Idempotency-Key"
        ]
      },
      {
        "method": "GET",
        "path": "/api/v1/integrations/n8n/results/{event_id}",
        "scope": "n8n.results.read",
        "required_headers": [
          "Authorization",
          "X-Tenant-ID",
          "X-Request-ID",
          "X-Correlation-ID"
        ]
      }
    ]
  },
  "credential": {
    "owner": "codestra-n8n-service-owner",
    "personal_account_allowed": false,
    "name": "Codestra Middleware Service",
    "type": "oAuth2Api",
    "grant_type": "clientCredentials",
    "keycloak_client_id": "n8n-automation",
    "token_url": "https://auth.codestra.co/realms/codestra/protocol/openid-connect/token",
    "audience": "middleware-api",
    "scopes": [
      "automation.job.claim",
      "automation.job.read",
      "automation.job.heartbeat",
      "automation.job.step.write",
      "automation.job.complete",
      "automation.job.fail",
      "automation.command.crm",
      "automation.command.read",
      "automation.approval.request",
      "automation.approval.read",
      "automation.operations.replay.request",
      "automation.operations.reconcile",
      "automation.capability.read",
      "n8n.results.submit",
      "n8n.results.read"
    ],
    "secret_source": "root-owned-bootstrap-secret-files",
    "secret_material_in_repository": false,
    "secret_material_in_workflow_json": false
  },
  "editor": {
    "strategy": "caddy-oauth2-proxy-keycloak-plus-native-owner",
    "issuer": "https://auth.codestra.co/realms/codestra",
    "required_any_roles": [
      "n8n_operator",
      "n8n_admin"
    ],
    "authorization_code_flow": true,
    "pkce_method": "S256",
    "native_owner_login_required": true,
    "native_owner_identity": "codestra-n8n-service-owner",
    "enterprise_sso_required": false,
    "direct_n8n_public_exposure": false,
    "caddy_contract_path": "config/n8n-editor-community.v1.json"
  },
  "security": {
    "environment_access_in_nodes": false,
    "public_api_enabled": false,
    "code_node_enabled": false,
    "community_packages_enabled": false,
    "dangerous_nodes_excluded": [
      "n8n-nodes-base.code",
      "n8n-nodes-base.emailSend",
      "n8n-nodes-base.executeCommand",
      "n8n-nodes-base.ftp",
      "n8n-nodes-base.git",
      "n8n-nodes-base.httpRequest",
      "n8n-nodes-base.localFileTrigger",
      "n8n-nodes-base.mariaDb",
      "n8n-nodes-base.mongoDb",
      "n8n-nodes-base.mySql",
      "n8n-nodes-base.odoo",
      "n8n-nodes-base.postgres",
      "n8n-nodes-base.readWriteFile",
      "n8n-nodes-base.redis",
      "n8n-nodes-base.ssh",
      "n8n-nodes-base.twilio"
    ]
  },
  "egress": {
    "policy_path": "deploy/egress/n8n-egress-policy.v1.json",
    "default_action": "DENY",
    "runtime_network_enforcement_required": true,
    "n8n_ssrf_protection_enabled": true,
    "allowed_https_hostnames": [
      "api.codestra.co",
      "auth.codestra.co"
    ],
    "blocked_ip_ranges": [
      "0.0.0.0/0",
      "::/0"
    ],
    "evidence_required_before_verified": true
  },
  "operations": {
    "active_workflows": 0,
    "external_effects_enabled": false,
    "production_changed": false,
    "umbrella_controls": {
      "LIVE_ADVERTISING_ENABLED": false,
      "EXTERNAL_DELIVERY_ENABLED": false,
      "SOCIAL_PUBLISHING_ENABLED": false,
      "EXTERNAL_MODEL_CALLS_ENABLED": false,
      "N8N_EXTERNAL_PROVIDER_WRITES": false
    }
  }
}

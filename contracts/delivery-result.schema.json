{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.codestra.co/automation/delivery-result.v1.json",
  "title": "Codestra delivery result",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "event_id",
    "tenant_id",
    "correlation_id",
    "idempotency_key",
    "status",
    "recorded_at"
  ],
  "properties": {
    "event_id": {
      "type": "string",
      "format": "uuid"
    },
    "tenant_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "correlation_id": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128
    },
    "idempotency_key": {
      "type": "string",
      "minLength": 8,
      "maxLength": 128
    },
    "status": {
      "enum": [
        "accepted",
        "duplicate",
        "completed",
        "rejected",
        "retry_scheduled",
        "dead_lettered"
      ]
    },
    "recorded_at": {
      "type": "string",
      "format": "date-time"
    },
    "provider_reference": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 256
    },
    "retry_after_seconds": {
      "type": [
        "integer",
        "null"
      ],
      "minimum": 0,
      "maximum": 86400
    },
    "error": {
      "type": [
        "object",
        "null"
      ],
      "additionalProperties": false,
      "properties": {
        "code": {
          "type": "string",
          "maxLength": 128
        },
        "message": {
          "type": "string",
          "maxLength": 1024
        },
        "retryable": {
          "type": "boolean"
        }
      }
    }
  }
}

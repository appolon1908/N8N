        "rawContentType": "application/json",
        "body": "={{JSON.stringify({job_id:$json.job_id || \"staging-klyrow-job\",lease_token:$json.lease_token || \"staging-lease\",execution_id:$execution.id,workflow_key:$json.workflow_key,workflow_version:\"1\",step_key:\"klyrow-email-event\",command_type:$json.event_command_type,dry_run:true,payload:{tenant_id:$json.tenant_id,domain:$json.domain,message_id:$json.message_id,event_type:\"delivery.test\"}})}}",
        "options": {"timeout": 10000}
      },
      "id": "cp-klyrow-request-event-command",
      "name": "Record Email Event Through Middleware",
      "type": "n8n-nodes-base.httpRequest",
